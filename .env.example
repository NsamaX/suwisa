# Discord Developer Portal > Bot. Never commit a real token.
DISCORD_TOKEN=
# Developer Mode in Discord > right click > Copy ID.
DISCORD_GUILD_ID=
ALLOWED_USER_IDS=
RECEIPT_CHANNEL_IDS=
# Comma-separated IDs are accepted for the two allowlists above.
DATABASE_PATH=data/suwisa.sqlite3
# For home server deployment: /mnt/data/backup/suwisa
BACKUP_DIR=./backups
TZ=Asia/Bangkok
OCR_TIMEOUT_SECONDS=30
MAX_ATTACHMENT_MB=10
# Linux/Docker: leave blank. Windows example: C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=
# Optional local language directory. Docker already includes Thai + English.
TESSDATA_DIR=
